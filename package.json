{
  "name": "svqtriana",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:prepare": "node scripts/prepare-preview.mjs",
    "preview:cf": "npm run build && npm run check:dist && node scripts/prepare-preview.mjs && npx --yes wrangler@4 pages deploy dist --project-name svqtriana-mvp --branch mvp",
    "check": "astro check",
    "check:dist": "node scripts/check-dist.mjs",
    "check:harness": "node scripts/check-harness.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "lhci autorun",
    "verify": "npm run check && npm run build && npm run check:dist && npm run check:harness && npm run test:e2e",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
