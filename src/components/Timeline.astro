---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['relative', className]}>
  <!-- The thread of the story: a red-and-white line running down like the river. -->
  <div
    class="absolute inset-y-2 left-[1.15rem] w-0.5 bg-gradient-to-b from-sevilla-500 via-sevilla-500/40 to-transparent md:left-[8.65rem]"
    aria-hidden="true"
  >
  </div>
  <ol class="space-y-14 sm:space-y-20">
    <slot />
  </ol>
</div>
