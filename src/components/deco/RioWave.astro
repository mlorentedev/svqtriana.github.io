---
interface Props {
  class?: string;
  flip?: boolean;
}

const { class: className = '', flip = false } = Astro.props;
---

<svg
  class:list={[className, flip && 'rotate-180']}
  viewBox="0 0 1440 44"
  fill="none"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="none"
>
  <path
    d="M0 22C120 2 240 42 360 22S600 2 720 22s240 20 360 0 240-20 360 0"
    stroke="currentColor"
    stroke-width="2"
    vector-effect="non-scaling-stroke"
  />
  <path
    d="M0 32C120 12 240 52 360 32S600 12 720 32s240 20 360 0 240-20 360 0"
    stroke="currentColor"
    stroke-width="1"
    opacity="0.45"
    vector-effect="non-scaling-stroke"
  />
</svg>
