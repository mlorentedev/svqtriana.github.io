---
import MobileNav from './MobileNav.astro';
import SocialLinks from './SocialLinks.astro';
import { nav } from '../data/site';
import { isNavActive } from '../lib/nav-active';

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-noche-950/95 shadow-[0_1px_0_rgb(255_255_255/0.08)] backdrop-blur">

  <div class="site-container flex items-center justify-between gap-4 py-2.5">
    <a href="/" class="group flex min-w-0 items-center gap-3">
      <img
        src="/images/webp/logo_192.webp"
        alt=""
        width="52"
        height="52"
        class="h-12 w-12 shrink-0 transition-transform duration-300 group-hover:-rotate-6 sm:h-[52px] sm:w-[52px]"
        decoding="async"
      />
      <span class="min-w-0 leading-none">
        <span class="block font-display text-xl tracking-tight text-cal-50 sm:text-2xl">SVQ Triana</span>
        <span class="mt-1 block text-[0.62rem] font-bold uppercase tracking-[0.24em] text-albero-400">
          Peña Sevillista
        </span>
        <span class="sr-only"> - Inicio</span>
      </span>
    </a>

    <nav class="hidden lg:block" aria-label="Navegación principal">
      <ul class="flex items-center gap-7">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                aria-current={isNavActive(pathname, item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden lg:block">
      <SocialLinks size={18} />
    </div>

    <MobileNav />
  </div>
</header>
